# Plantilla de las variables que necesita docker-compose.yml.
#
# Copiala a un archivo llamado '.env' EN ESTA MISMA CARPETA y rellena los valores.
# Docker Compose lee ese '.env' automaticamente. '.env' esta en .gitignore: nunca se sube.
#
#   cp .env.example .env      (PowerShell: Copy-Item .env.example .env)
#
# Solo hace falta si vas a levantar la API en contenedor (--profile app). Para la infra sola
# no se usa ninguna de estas variables.

# El clientSecret con el que Agendia nos conoce (clientId "soundmate" en su registro de
# ServiceClients). Fuera del contenedor vive en user-secrets:
#   dotnet user-secrets list --project ../SoundMate.API
AGENDIA_CLIENT_SECRET=
